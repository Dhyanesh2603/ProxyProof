# ProxyProof Environment Configuration
PROJECT_NAME=ProxyProof
VERSION=1.0.0
SECRET_KEY=proxyproof-super-secure-production-master-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for Docker, SQLite for local standalone development)
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/proxyproof
POSTGRES_DB=proxyproof
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Redis
REDIS_URL=redis://redis:6379/0

# Security & BLE Parameters
ROTATING_TOKEN_INTERVAL_SECONDS=5
ROTATING_TOKEN_GRACE_WINDOWS=1
DEFAULT_RSSI_THRESHOLD=-75
ATTENDANCE_LATE_THRESHOLD_MINUTES=15
